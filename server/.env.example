# galley API configuration. Copy to .env (not committed) or set in the
# deployment environment. All variables are required except the mail ones;
# "serve" refuses to start without them. Placeholders only: never commit real values.

# GitHub App OAuth credentials (Settings > Developer settings > GitHub Apps).
GALLEY_GITHUB_CLIENT_ID=Iv1.0000000000000000
GALLEY_GITHUB_CLIENT_SECRET=replace-me

# 32 random bytes, standard base64. Encrypts stored refresh tokens and the
# login cookie; a separate key derived from it (HKDF) encrypts comments.
# Changing it signs everyone out AND makes every stored comment unreadable.
# Keep it outside pb_data and back it up. Generate with: openssl rand -base64 32
GALLEY_TOKEN_KEY=replace-me-with-openssl-rand-base64-32

# Webhook secret configured in the GitHub App.
GALLEY_WEBHOOK_SECRET=replace-me

# Exact browser origin of the frontend (scheme://host[:port], no path).
GALLEY_FRONTEND_ORIGIN=https://galley.fullfran.com

# Public base URL of this API. The OAuth callback is
# $GALLEY_PUBLIC_URL/api/galley/auth/callback.
GALLEY_PUBLIC_URL=https://galley-api.fullfran.com

# Optional: email notifications for direct asks (review requests,
# assignments) through Resend. Without both, notifications are disabled.
# GALLEY_RESEND_API_KEY=re_replace-me
# GALLEY_MAIL_FROM=galley <notify@notify.fullfran.com>
