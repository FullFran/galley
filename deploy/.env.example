# galley API deployment. Copy to deploy/.env on the VPS, fill it, and
# `chmod 600 .env`. Placeholders only: never commit real values.

# GitHub App (Settings > Developer settings > GitHub Apps > galley).
GALLEY_GITHUB_CLIENT_ID=Iv23-replace-me
GALLEY_GITHUB_CLIENT_SECRET=replace-me
# Same value as the webhook secret set in the GitHub App.
GALLEY_WEBHOOK_SECRET=replace-me

# 32 random bytes, standard base64: openssl rand -base64 32
# Encrypts stored refresh tokens. Rotating it signs everyone out.
GALLEY_TOKEN_KEY=replace-me

# Exactly 32 characters: openssl rand -base64 24
# PocketBase uses it to encrypt its settings in pb_data.
PB_ENCRYPTION_KEY=replace-me

# Existing Traefik setup. The shadow-dungeon plan names `dokploy-network`
# and `letsencrypt`; confirm both against the Traefik config on the VPS.
TRAEFIK_NETWORK=replace-me-traefik-network
TRAEFIK_CERTRESOLVER=replace-me-certresolver

# Optional: IPs/CIDRs (comma separated) allowed to reach /_/ and the
# superuser auth API through Traefik. Default 127.0.0.1/32 blocks everyone;
# use the SSH tunnel instead.
# GALLEY_ADMIN_ALLOWLIST=203.0.113.7/32

# Optional: host loopback port for the SSH tunnel to the admin UI.
# GALLEY_ADMIN_LOCAL_PORT=8091
